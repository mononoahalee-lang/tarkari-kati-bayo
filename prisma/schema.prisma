generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Market {
  id                String             @id @default(cuid())
  nameNe            String
  nameEn            String
  district          String
  source            String             // "kalimati" | "ampis"
  prices            PriceRecord[]
  fieldObservations FieldObservation[]

  @@unique([nameEn])
}

model Vegetable {
  id                String             @id @default(cuid())
  nameNe            String             @unique
  nameEn            String
  nameJa            String
  category          String             @default("vegetable")
  unit              String             @default("kg")
  prices            PriceRecord[]
  fieldObservations FieldObservation[]
}

model PriceRecord {
  id          String    @id @default(cuid())
  vegetableId String
  marketId    String
  date        DateTime  @db.Date
  minPrice    Float
  maxPrice    Float
  avgPrice    Float
  vegetable   Vegetable @relation(fields: [vegetableId], references: [id])
  market      Market    @relation(fields: [marketId], references: [id])

  @@unique([vegetableId, marketId, date])
  @@index([date])
  @@index([vegetableId])
  @@index([marketId])
  // Composite indexes for DISTINCT ON (vegetableId) ORDER BY vegetableId, date DESC
  @@index([vegetableId, date(sort: Desc)])
  // Composite index for market-filtered queries: WHERE marketId = ? ORDER BY vegetableId, date DESC
  @@index([marketId, vegetableId, date(sort: Desc)])
}

model NewsItem {
  id          String   @id @default(cuid())
  titleNe     String?
  titleEn     String
  titleJa     String?
  url         String   @unique
  source      String
  publishedAt DateTime
  summary     String?
  createdAt   DateTime @default(now())
}

model ScrapeLog {
  id        String   @id @default(cuid())
  source    String   // "kalimati" | "ampis"
  runAt     DateTime @default(now())
  targetDate DateTime @db.Date
  itemsCount Int
  success   Boolean
  message   String?

  @@index([source, runAt(sort: Desc)])
}

model SeedVariety {
  id                 String    @id @default(cuid())
  sqccId             Int       @unique
  name               String
  nepName            String?
  cropName           String
  cropSlug           String
  ownerType          String    // "private" | "narc" | "other" (SQCC's own classification)
  narcVariety        Boolean   @default(false)
  typeOpHybrid       String?   // "Hybrid" | "OP" | "Inbred Male" | "Inbred Female" | null
  isRegistered       Boolean   @default(false)
  releasedDate       DateTime? @db.Date
  releasedFiscalYear Int?
  recommendedAreas   String?
  slug               String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([cropSlug])
  @@index([ownerType])
}

model FieldObservation {
  id            String    @id @default(cuid())
  date          DateTime  @db.Date
  storeName     String
  location      String
  marketId      String?
  vegetableId   String
  observedPrice Float
  marketPrice   Float?
  note          String?
  createdAt     DateTime  @default(now())

  vegetable     Vegetable @relation(fields: [vegetableId], references: [id])
  market        Market?   @relation(fields: [marketId], references: [id])

  @@index([date(sort: Desc)])
}
